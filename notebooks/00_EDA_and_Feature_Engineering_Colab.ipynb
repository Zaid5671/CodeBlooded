   "source": [
    "# SIH26102 — Exploratory Data Analysis (EDA) & Feature Engineering\n",
    "**MPLADS Audit Intelligence Platform | Team CodeBlooded**\n",
    "\n",
    "This notebook performs comprehensive **Exploratory Data Analysis (EDA)** and **Feature Engineering (FE)** on Lok Sabha 18th Sanctioned Works (79,220 works) and Raw Expenditure Transactions (84,172 transactions)."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1: Environment Setup & Data Ingestion"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Self-contained Repository & Path Setup for Google Colab\n",
    "import os, sys, glob, zipfile, shutil\n",
    "\n",
    "# 1. Extract project ZIP if uploaded\n",
    "if os.path.exists(\"/content/CodeBlooded-main.zip\"):\n",
    "    with zipfile.ZipFile(\"/content/CodeBlooded-main.zip\", 'r') as zip_ref:\n",
    "        zip_ref.extractall(\"/content\")\n",
    "    if os.path.exists(\"/content/CodeBlooded-main\"):\n",
    "        os.chdir(\"/content/CodeBlooded-main\")\n",
    "\n",
    "# 2. Ensure data folder exists\n",
    "target_dir = \"data/original/LokSabha18\"\n",
    "os.makedirs(target_dir, exist_ok=True)\n",
    "if os.path.exists(\"/content/LokSabha18\"):\n",
    "    for f in os.listdir(\"/content/LokSabha18\"):\n",
    "        src = os.path.join(\"/content/LokSabha18\", f)\n",
    "        dst = os.path.join(target_dir, f)\n",
    "        if not os.path.exists(dst):\
    "            if os.path.isdir(src):\n",
    "                shutil.copytree(src, dst)\n",
    "            else:\n",
    "                shutil.copy2(src, dst)\n",
    "\n",
    "sys.path.insert(0, os.getcwd())\n",
    "os.environ[\"PYTHONPATH\"] = os.getcwd()\n",
    "print(\"Working Directory:\", os.getcwd())\n",
    "!pip install -q pandas numpy scikit-learn matplotlib seaborn pytest"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2: Exploratory Data Analysis (EDA)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from data_pipeline.data_loader import load_sanctioned_works, load_expenditure_works\n",
    "\n",
    "print(\"==================================================\")\n",
    "print(\"          1. EXPLORATORY DATA ANALYSIS (EDA)\")\n",
    "print(\"==================================================\")\n",
    "\n",
    "df_sanc = load_sanctioned_works()\n",
    "df_exp = load_expenditure_works()\n",
    "\n",
    "print(f\"📊 Sanctioned Works Shape: {df_sanc.shape[0]:,} rows x {df_sanc.shape[1]} columns\")\n",
    "print(f\"📊 Raw Expenditure Transactions Shape: {df_exp.shape[0]:,} rows x {df_exp.shape[1]} columns\\n\")\n",
    "\n",
    "# Missing Values Audit\n",
    "missing = df_sanc.isnull().sum()\n",
    "missing_pct = (missing / len(df_sanc)) * 100\n",
    "df_missing = pd.DataFrame({'Missing Count': missing, 'Missing %': missing_pct.round(2)})\n",
    "print(\"--- MISSING VALUE AUDIT ---\")\n",
    "display(df_missing[df_missing['Missing Count'] > 0])\n",
    "\n",
    "# Monetary Summary Statistics\n",
    "sanc_amounts = pd.to_numeric(df_sanc['Sanction Amount'].astype(str).str.replace(',', ''), errors='coerce')\n",
    "print(\"\\n--- SANCTION AMOUNT DESCRIPTIVE STATISTICS (₹) ---\")\n",
    "print(f\"Min Amount: ₹{sanc_amounts.min():,.2f}\")\n",
    "print(f\"Max Amount: ₹{sanc_amounts.max():,.2f}\")\n",
    "print(f\"Mean Amount: ₹{sanc_amounts.mean():,.2f}\")\n",
    "print(f\"Median Amount: ₹{sanc_amounts.median():,.2f}\")\n",
    "print(f\"Std Deviation: ₹{sanc_amounts.std():,.2f}\")\n",
    "q25, q75 = sanc_amounts.quantile(0.25), sanc_amounts.quantile(0.75)\n",
    "print(f\"IQR (Q75 - Q25): ₹{q75 - q25:,.2f} [₹{q25:,.2f} to ₹{q75:,.2f}]\")\n",
    "\n",
    "# Plot Distribution\n",
    "plt.figure(figsize=(12, 5))\n",
    "plt.subplot(1, 2, 1)\n",
    "sns.histplot(sanc_amounts.dropna(), bins=40, kde=True, color='navy')\n",
    "plt.title(\"Sanction Amount (Linear Scale)\")\n",
    "plt.xlabel(\"Sanction Amount (₹)\")\n",
    "\n",
    "plt.subplot(1, 2, 2)\n",
    "sns.histplot(np.log1p(sanc_amounts.dropna()), bins=40, kde=True, color='crimson')\n",
    "plt.title(\"Log-Sanction Amount (log1p Scale)\")\n",
    "plt.xlabel(\"Log(Sanction Amount + 1)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 3: Feature Engineering Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from feature_engineering.preprocessing import preprocess_sanctioned_works\n",
    "from feature_engineering.category_classifier import apply_category_classification\n",
    "from feature_engineering.nlp_text_processor import clean_nlp_text\n",
    "from ml.model_1_cost_anomaly.overrun_rules import evaluate_cost_overrun\n",
    "from ml.model_1_cost_anomaly.peer_analysis import evaluate_peer_iqr\n",
    "from ml.model_3_expenditure_anomaly.expenditure_matching import match_expenditure_data\n",
    "\n",
    "print(\"==================================================\")\n",
    "print(\"          2. FEATURE ENGINEERING PIPELINE\")\n",
    "print(\"==================================================\")\n",
    "\n",
    "# 1. Clean & Extract Canonical Work ID\n",
    "df_prep = preprocess_sanctioned_works(df_sanc)\n",
    "print(f\"✅ Feature 1 (Canonical Work ID): Parsed {df_prep['clean_work_id'].notnull().sum():,} clean IDs\")\n",
    "\n",
    "# 2. Rule-Based Category Classifier & NLP Normalization\n",
    "df_cat = apply_category_classification(df_prep)\n",
    "df_cat['cleaned_work_name'] = df_cat['Work Name'].apply(clean_nlp_text)\n",
    "print(f\"✅ Feature 2 (Category Classification & NLP Text): Classified {df_cat['work_category'].nunique()} work categories\")\n",
    "print(f\"   Category Distribution:\\n{df_cat['work_category'].value_counts()}\\n\")\n",
    "\n",
    "# 3. Robust Peer IQR & MAD Features\n",
    "df_s1 = evaluate_cost_overrun(df_cat)\n",
    "df_s2 = evaluate_peer_iqr(df_s1)\n",
    "print(f\"✅ Feature 3 (Peer IQR & Robust Deviation): Calculated for {df_s2['peer_group_id'].nunique():,} State x Category peer groups\")\n",
    "print(f\"   Robust Deviation Summary:\")\n",
    "print(df_s2[['robust_deviation', 'peer_deviation_ratio']].describe())\n",
    "\n",
    "# 4. Expenditure & Behavioral Payment Features\n",
    "df_fe = match_expenditure_data(df_s2, df_exp)\n",
    "print(f\"\\n✅ Feature 4 (Behavioral Payment Features): Derived payment counts & voucher ratios\")\n",
    "print(f\"   Multi-Payment Works (>1 vouchers): {(df_fe['num_payments'] > 1).sum():,}\")\n",
    "print(f\"   Max Payment Ratio (Largest voucher / Total): mean = {df_fe['max_payment_ratio'].mean():.2f}\")\n",
    "\n",
    "# Display Engineered Feature Matrix Sample\n",
    "fe_cols = [\n",
    "    'clean_work_id', 'State', 'work_category', 'sanction_amount',\n",
    "    'robust_deviation', 'peer_deviation_ratio', 'num_payments', 'max_payment_ratio'\n",
    "]\n",
    "print(\"\\n--- ENGINEERED FEATURE MATRIX SAMPLE ---\")\n",
    "display(df_fe[fe_cols].head(10))"
   ]
  }
 ],
